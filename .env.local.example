# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (whsec_...) from your Resend webhook settings.
# Leave blank until you create a webhook endpoint.
RESEND_WEBHOOK_SECRET=

# Verified sender address — must be on a domain you've verified in Resend.
FROM_EMAIL=tickets@yourdomain.com
